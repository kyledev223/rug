# Copy to .env.local and fill in. Everything except NEXT_PUBLIC_* stays server-side.

# --- Solana data ---
# Helius free tier: https://dashboard.helius.dev (RPC + DAS metadata). Strongly recommended:
# the public RPC rate-limits getTokenLargestAccounts, so holder checks show "unknown" without it.
HELIUS_API_KEY=
# Optional custom RPC used only when HELIUS_API_KEY is empty.
SOLANA_RPC_URL=

# --- AI explanations (optional; templates are used when unset or rate-limited) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Newest free-tier Flash model as of Oct 2026. Check https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# --- Supabase (Postgres). Without these the app uses in-memory storage (dev only). ---
SUPABASE_URL=
# Settings -> API -> service_role key. Server-only: never expose this.
SUPABASE_SERVICE_ROLE_KEY=

# --- Security ---
# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Salt for hashing IPs before storage (defaults to SESSION_SECRET).
IP_HASH_SALT=
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token automatically).
CRON_SECRET=

# --- Public config ---
# Your deployed URL, used for OG images and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Holder token mint. Leave empty until launch (token section hidden, no holder tiers).
NEXT_PUBLIC_TOKEN_MINT=

# --- Local testing only (ignored in production builds) ---
# Force a tier 0-3 for the signed-in wallet to test gated features before the token exists.
DEV_FORCE_TIER=
